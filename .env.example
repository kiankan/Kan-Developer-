# ═══════════════════════════════════════════════════════════════ cPanel TeamKan ═══
# تنها مقدار الزامی، توکن ربات است. بقیه‌ی تنظیمات (سرورهای cPanel/WHM،
# ادمین‌ها و ...) بعد از نصب از داخل خود ربات انجام می‌شود.
# ════════════════════════════════════════════════════════════════════════════

# توکن ربات از @BotFather  ← الزامی
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather

# ---------------------------------------------------------------- ادمین‌ها --
# لازم نیست پر شود: بعد از نصب، اسکریپت یک «کد نصب» چاپ می‌کند و اولین کسی که
# آن کد را برای ربات بفرستد مالک می‌شود. بقیه‌ی ادمین‌ها از داخل ربات اضافه
# می‌شوند (👮 ادمین‌ها). اگر اینجا آیدی بگذارید، آن ادمین «ثابت» است و از داخل
# ربات حذف نمی‌شود.
ADMIN_ID=
ADMIN_IDS=

# ------------------------------------------------------- سرویس خود ربات ----
# پورت صفحه‌ی وضعیت/سلامت ربات. ربطی به پورت هاست‌هایی که مدیریت می‌کنید ندارد؛
# هر هاست پورت خودش را دارد (2083، 2087، 2096، ...) و همه هم‌زمان کار می‌کنند.
LISTEN_PORT=2000

# فقط در حالت وبهوک لازم است: یک رشته‌ی تصادفی، تا فقط تلگرام بتواند به آدرس
# وبهوک درخواست بدهد.
WEBHOOK_SECRET=

# اگر api.telegram.org از سرور شما مستقیم در دسترس نیست، آدرس پروکسی/آینه:
TELEGRAM_API_BASE=

# ------------------------------- سرور cPanel/WHM (اختیاری، از ربات هم می‌شود)
# اگر می‌خواهید همان اول از فایل تنظیم شود، اینجا پرش کنید؛ وگرنه از داخل ربات:
# ⚙️ سرورها → ➕ افزودن سرور
#
# آدرس را می‌توانید با پورت بنویسید (server.example.com:2096) یا پورت را جدا
# در CPANEL_PORT بگذارید. توکن را از cPanel → Security → Manage API Tokens
# بسازید.
CPANEL_HOST=
CPANEL_PORT=2083
CPANEL_USER=
CPANEL_TOKEN=
CPANEL_LABEL=
CPANEL_SSL_VERIFY=1

# دسترسی سطح سرور (WHM → Development → Manage API Tokens)
WHM_HOST=
WHM_PORT=2087
WHM_USER=root
WHM_TOKEN=
WHM_LABEL=
WHM_SSL_VERIFY=1

# حالت کران روی هاست اشتراکی: هر اجرای poll.php چند ثانیه گوش بدهد.
POLL_SECONDS=55
