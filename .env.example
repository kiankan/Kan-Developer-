# ---------------------------------------------------------------- تلگرام ----
# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather

# آیدی عددی تلگرام ادمین (نه یوزرنیم) — از @userinfobot بگیرید.
# تا وقتی این مقدار تنظیم نشود، ربات هیچ دستوری را اجرا نمی‌کند (چون این ربات
# به سرور شما دسترسی مدیریتی دارد و نباید برای همه باز باشد).
ADMIN_ID=123456789
# چند ادمین؟ با کاما جدا کنید (اختیاری):
ADMIN_IDS=

# ------------------------------------------------------- سرویس خود ربات ----
# پورتی که صفحه‌ی وضعیت/سلامت ربات روی آن بالا می‌آید (serve.php).
# این پورت هیچ ربطی به پورت هاست‌هایی که مدیریت می‌کنید ندارد؛ هر هاست پورت
# خودش را دارد (2083، 2087، 2096، ...) و همه هم‌زمان کار می‌کنند.
LISTEN_PORT=2000

# اگر ربات را در حالت وبهوک اجرا می‌کنید، یک رشته‌ی تصادفی اینجا بگذارید تا
# فقط تلگرام بتواند به آدرس وبهوک درخواست بدهد.
WEBHOOK_SECRET=

# حالت کران (هاست اشتراکی): هر اجرای poll.php چند ثانیه گوش بدهد.
POLL_SECONDS=55

# اگر api.telegram.org از سرور شما مستقیم در دسترس نیست، آدرس پروکسی/آینه:
TELEGRAM_API_BASE=

# ----------------------------------------------------------- حساب cPanel ----
# آدرس سرور. می‌توانید پورت را داخل خود آدرس بنویسید (server.example.com:2083)
# یا جدا در CPANEL_PORT بگذارید. اگر هیچ‌کدام نبود، 2083 در نظر گرفته می‌شود.
CPANEL_HOST=server.example.com
CPANEL_PORT=2083
# نام کاربری همان حساب cPanel
CPANEL_USER=cpaneluser
# API Token از مسیر cPanel → Security → Manage API Tokens
CPANEL_TOKEN=
# اسم دلخواه برای نمایش در ربات (اختیاری)
CPANEL_LABEL=
# اگر گواهی SSL سرور خودامضاست، برای تست می‌توانید 0 بگذارید (توصیه نمی‌شود)
CPANEL_SSL_VERIFY=1

# ------------------------------------------------- دسترسی سطح سرور (WHM) ----
# اختیاری: با توکن WHM می‌توانید همه‌ی حساب‌های سرور را مدیریت کنید
# (لیست/ساخت/تعلیق/حذف حساب، لینک ورود، وضعیت سرویس‌ها) و کارهای سطح حساب را
# هم روی هر کاربری اجرا کنید.
WHM_HOST=
WHM_PORT=2087
WHM_USER=root
# API Token از مسیر WHM → Development → Manage API Tokens
WHM_TOKEN=
WHM_LABEL=
WHM_SSL_VERIFY=1
