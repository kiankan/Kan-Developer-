TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# آیدی عددی تلگرام ادمین (نه یوزرنیم) — از طریق @userinfobot بگیرید.
# اگر خالی بماند، ربات به پیام هر کسی پاسخ می‌دهد.
ADMIN_ID=123456789

# اختیاری: کلید رمزنگاری اطلاعات هاست‌های ذخیره‌شده (رمز/توکن cPanel) روی
# دیسک، به‌صورت base64 مربوط به ۳۲ بایت تصادفی. اگر خالی بماند، ربات خودش
# یک کلید تصادفی می‌سازد و در data/app.key نگه می‌دارد (کافیه برای اجرای
# تکی روی یک سرور، ولی برای بکاپ/جابه‌جایی امن‌تره خودتون یکی بسازید و اینجا
# ثابت نگهش دارید — با دستور زیر می‌تونید بسازید):
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# اختیاری: اگر هاست شما گواهی SSL معتبر/امضاشده نداره (مثلاً self-signed روی
# یک سرور تست)، با گذاشتن این مقدار روی 1 می‌تونید بررسی گواهی رو غیرفعال
# کنید. برای هاست‌های واقعی توصیه نمی‌شه چون امنیت اتصال رو کم می‌کنه.
CPANEL_INSECURE_SSL=0
