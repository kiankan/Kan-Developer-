[Unit]
Description=kan_checker Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kan_checker
EnvironmentFile=/opt/kan_checker/.env
ExecStart=/usr/bin/php /opt/kan_checker/bot.php
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
