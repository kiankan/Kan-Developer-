[Unit]
Description=kan_checker Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kan_checker
EnvironmentFile=/opt/kan_checker/.env
ExecStart=/opt/kan_checker/.venv/bin/python /opt/kan_checker/bot.py
Restart=on-failure
RestartSec=5
User=kan_checker

[Install]
WantedBy=multi-user.target
