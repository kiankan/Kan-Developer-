[Unit]
Description=cPanel TeamKan — cPanel/WHM manager Telegram bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/teamkan
EnvironmentFile=/opt/teamkan/.env
ExecStart=/usr/bin/php /opt/teamkan/bot.php
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=25%
MemoryMax=128M

[Install]
WantedBy=multi-user.target
