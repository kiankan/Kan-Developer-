#!/usr/bin/env bash
# منوی مدیریت kan_checker روی سرور (systemd، PHP)، به‌همراه دستورهای مستقیم.
#
# نصب اولیه، تعاملی (توکن و آیدی ادمین رو می‌پرسه):
#   bash <(curl -Ls https://raw.githubusercontent.com/kiankan/kan_checker/main/kancheckerctl) install
#
# یا کاملا خودکار روی SSH بدون هیچ سوالی:
#   TELEGRAM_BOT_TOKEN=xxx ADMIN_ID=123456789 \
#     bash <(curl -Ls https://raw.githubusercontent.com/kiankan/kan_checker/main/kancheckerctl) install
#
# بعد از نصب، از هر جای سرور کافیه بنویسید:
#   kancheckerctl            # منو رو باز می‌کند
#   kancheckerctl update     # آپدیت مستقیم (و در صورت نیاز مهاجرت خودکار نسخه‌ی قدیمی پایتون به PHP)
#   kancheckerctl status     # وضعیت مستقیم
#   و ...

set -uo pipefail

REPO_URL="https://github.com/kiankan/kan_checker.git"
INSTALL_DIR="/opt/kan_checker"
SERVICE_NAME="kan_checker-bot"
ENV_FILE="$INSTALL_DIR/.env"
BIN_PATH="/usr/local/bin/kancheckerctl"

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "این عملیات نیاز به دسترسی root دارد. با sudo اجرا کنید."
    exit 1
  fi
}

ensure_repo() {
  if [ -d "$INSTALL_DIR/.git" ]; then
    git -C "$INSTALL_DIR" pull --ff-only
  else
    mkdir -p "$INSTALL_DIR"
    git clone "$REPO_URL" "$INSTALL_DIR"
  fi
}

install_deps_os() {
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -y
    apt-get install -y php-cli php-curl php-xml php-mbstring git
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y php-cli php-curl php-xml php-mbstring git
  elif command -v yum >/dev/null 2>&1; then
    yum install -y php-cli php-curl php-xml php-mbstring git
  else
    echo "پکیج‌منیجر شناخته‌شده‌ای پیدا نشد؛ لطفاً php-cli (با پسوندهای curl/xml/mbstring) و git را خودتان نصب کنید."
  fi
}

# اگر نصب قبلی پایتون (نسخه‌ی قدیمی این پروژه) باقی مانده باشه پاکش می‌کنه.
cleanup_legacy_python() {
  if [ -d "$INSTALL_DIR/.venv" ]; then
    echo "نصب قدیمی پایتون پیدا شد؛ در حال مهاجرت به PHP ..."
    rm -rf "$INSTALL_DIR/.venv"
  fi
}

prompt_config() {
  local current_token="" current_admin=""
  if [ -f "$ENV_FILE" ]; then
    current_token=$(grep '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)
    current_admin=$(grep '^ADMIN_ID=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)
  fi

  # اگر از قبل به‌صورت متغیر محیطی داده شده باشن (مثلا برای نصب کاملا خودکار روی
  # سرور از طریق SSH)، هیچ سوالی پرسیده نمی‌شه:
  #   TELEGRAM_BOT_TOKEN=xxx ADMIN_ID=123 kancheckerctl install
  local token="${TELEGRAM_BOT_TOKEN:-}"
  local admin="${ADMIN_ID:-}"

  if [ -z "$token" ]; then
    if [ -n "$current_token" ]; then
      read -rp "توکن ربات از قبل تنظیم شده. برای تغییر، توکن جدید را وارد کنید (Enter = رد شدن): " token
      [ -z "$token" ] && token="$current_token"
    else
      read -rp "توکن ربات تلگرام (از @BotFather) را وارد کنید: " token
    fi
  fi

  if [ -z "$admin" ]; then
    if [ -n "$current_admin" ]; then
      read -rp "آیدی عددی ادمین از قبل تنظیم شده. برای تغییر، مقدار جدید را وارد کنید (Enter = رد شدن): " admin
      [ -z "$admin" ] && admin="$current_admin"
    else
      read -rp "آیدی عددی تلگرام ادمین (از @userinfobot بگیرید، نه یوزرنیم) را وارد کنید: " admin
    fi
  fi

  {
    echo "TELEGRAM_BOT_TOKEN=$token"
    echo "ADMIN_ID=$admin"
  } > "$ENV_FILE"
}

write_systemd_unit() {
  cat > "/etc/systemd/system/${SERVICE_NAME}.service" <<EOF
[Unit]
Description=kan_checker Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$INSTALL_DIR
EnvironmentFile=$ENV_FILE
ExecStart=$(command -v php || echo /usr/bin/php) $INSTALL_DIR/bot.php
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

self_link() {
  if [ -f "$INSTALL_DIR/kancheckerctl" ]; then
    cp "$INSTALL_DIR/kancheckerctl" "$BIN_PATH"
    chmod +x "$BIN_PATH"
  fi
}

do_install() {
  need_root
  echo "== نصب kan_checker روی سرور (PHP) =="
  install_deps_os
  ensure_repo
  cleanup_legacy_python
  prompt_config
  write_systemd_unit
  self_link
  systemctl enable --now "$SERVICE_NAME"
  echo ""
  echo "نصب کامل شد و سرویس در حال اجراست."
  echo "از این به بعد کافیه بنویسید: kancheckerctl"
}

# مرحله‌ی نهایی آپدیت؛ همیشه با نسخه‌ی تازه pull‌شده‌ی خود اسکریپت اجرا می‌شه
# (بعد از self_link)، تا مهاجرت‌هایی مثل پایتون -> PHP همیشه با آخرین منطق انجام بشه.
do_finish_update() {
  need_root
  install_deps_os
  cleanup_legacy_python
  write_systemd_unit
  systemctl restart "$SERVICE_NAME"
  echo "آپدیت انجام شد و سرویس با آخرین نسخه (PHP) ری‌استارت شد."
}

do_update() {
  need_root
  if [ ! -d "$INSTALL_DIR/.git" ]; then
    echo "هنوز نصب نشده. اول گزینه «نصب» را بزنید."
    return 1
  fi
  echo "== به‌روزرسانی kan_checker =="
  ensure_repo
  self_link
  # با باینری تازه self-link‌شده ادامه می‌دیم تا همیشه آخرین منطق مهاجرت اجرا بشه.
  # اگه از نسخه‌ی خیلی قدیمی (قبل از این قابلیت) آپدیت می‌کنید، همین دستور را
  # یک بار دیگر هم بزنید تا مهاجرت کامل شود.
  exec "$BIN_PATH" _finish-update
}

do_start()   { need_root; systemctl start "$SERVICE_NAME";   echo "سرویس استارت شد."; }
do_stop()    { need_root; systemctl stop "$SERVICE_NAME";    echo "سرویس متوقف شد."; }
do_restart() { need_root; systemctl restart "$SERVICE_NAME"; echo "سرویس ری‌استارت شد."; }
do_status()  { systemctl status "$SERVICE_NAME" --no-pager; }
do_logs()    { journalctl -u "$SERVICE_NAME" -f -n 100; }

do_set_token() {
  need_root
  prompt_config
  systemctl restart "$SERVICE_NAME" 2>/dev/null
  echo "توکن/آیدی ادمین به‌روز شد و سرویس ری‌استارت شد."
}

do_uninstall() {
  need_root
  read -rp "مطمئنید می‌خواهید kan_checker کاملاً حذف شود؟ (y/N): " confirm
  if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "لغو شد."
    return
  fi
  systemctl disable --now "$SERVICE_NAME" 2>/dev/null
  rm -f "/etc/systemd/system/${SERVICE_NAME}.service"
  systemctl daemon-reload
  rm -rf "$INSTALL_DIR"
  rm -f "$BIN_PATH"
  echo "حذف کامل شد."
}

show_menu() {
  while true; do
    echo ""
    echo "==== kan_checker — منوی مدیریت سرور ===="
    echo "1) نصب"
    echo "2) آپدیت"
    echo "3) شروع سرویس"
    echo "4) توقف سرویس"
    echo "5) ری‌استارت سرویس"
    echo "6) وضعیت سرویس"
    echo "7) نمایش لاگ (زنده، خروج با Ctrl+C)"
    echo "8) تنظیم/تغییر توکن و آیدی ادمین"
    echo "9) حذف کامل"
    echo "0) خروج"
    read -rp "انتخاب شما: " choice
    case "$choice" in
      1) do_install ;;
      2) do_update ;;
      3) do_start ;;
      4) do_stop ;;
      5) do_restart ;;
      6) do_status ;;
      7) do_logs ;;
      8) do_set_token ;;
      9) do_uninstall ;;
      0) exit 0 ;;
      *) echo "گزینه نامعتبر است." ;;
    esac
  done
}

cmd="${1:-menu}"
case "$cmd" in
  install)          do_install ;;
  update)           do_update ;;
  _finish-update)   do_finish_update ;;
  start)            do_start ;;
  stop)             do_stop ;;
  restart)          do_restart ;;
  status)           do_status ;;
  logs)             do_logs ;;
  set-token|token)  do_set_token ;;
  uninstall|remove) do_uninstall ;;
  menu|"")          show_menu ;;
  *)
    echo "دستور نامعتبر: $cmd"
    echo "دستورهای معتبر: install, update, start, stop, restart, status, logs, set-token, uninstall, menu"
    exit 1
    ;;
esac
